@@ -0,0 +1,40 @@
+#include "runner_common.cuh"
+
+namespace {
+
+__global__ void transpose_tiled_padded_kernel(const float* input, float* output, int rows, int cols) {
+    __shared__ float tile[32][33];
+    const int col = blockIdx.x * 32 + threadIdx.x;
+    const int row = blockIdx.y * 32 + threadIdx.y;
+    if (row < rows && col < cols) {
+        tile[threadIdx.y][threadIdx.x] = input[row * cols + col];
+    }
+    __syncthreads();
+    const int output_col = blockIdx.y * 32 + threadIdx.x;
+    const int output_row = blockIdx.x * 32 + threadIdx.y;
+    if (output_row < cols && output_col < rows) {
+        output[output_row * rows + output_col] = tile[threadIdx.x][threadIdx.y];
+    }
+}
+
+void launch_transpose_tiled_padded(const float* input, float* output, int rows, int cols,
+                                   cudaStream_t stream) {
+    constexpr int tile = 32;
+    const dim3 block(tile, tile);
+    const dim3 grid((cols + tile - 1) / tile, (rows + tile - 1) / tile);
+    transpose_tiled_padded_kernel<<<grid, block, 0, stream>>>(input, output, rows, cols);
+    OPTIMIZER_CUDA_CHECK(cudaGetLastError());
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    try {
+        const auto options = optimizer_transpose::parse_options(argc, argv);
+        return optimizer_transpose::run_workload(
+            options, "transpose_tiled_padded", launch_transpose_tiled_padded);
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
